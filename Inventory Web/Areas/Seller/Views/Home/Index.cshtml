@{
    ViewData["Title"] = "Home Page";
}
@model HomeVM
<div class="container">
    <div class="row">
        <div class="w-25">
            <div class="card text-white bg-dark">
                <div class="card-header bg-dark">Product</div>
                <div class="card-body">
                    <p class="card-title">Total Product: @ViewBag.Product</p>
                </div>
            </div>
        </div>
        <div class="w-25">
            <div class="card text-white bg-dark">
                <div class="card-header bg-dark">Order</div>
                <div class="card-body">
                    <p class="card-title">Total Order: @ViewBag.Order </p>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col">
            <div class="mb-2">
                <h2>Orders</h2>
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>City</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var i in Model.orders)
                    {
                        <tr>
                            <td>@i.Name</td>
                            <td>@i.City</td>
                            <td>@i.Street</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col">
            <div class="mb-2">
                <h2>Products</h2>
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name Produk</th>
                        <th>Category Product</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.product)
                    {
                        <tr>
                            <th>@i.title</th>
                            <td>@i.Category.Name</td>
                            <td>@i.price</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
